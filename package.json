{
  "name": "typescript-coverage-report",
  "version": "1.1.1",
  "description": "Node command tool to generate TypeScript coverage report.",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "bin": {
    "typescript-coverage-report": "dist/bin/typescript-coverage-report.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "repository": "git@github.com:alexcanessa/typescript-coverage-report.git",
  "author": "Alex Canessa <canessa.alex@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "chalk": "4.1.2",
    "cli-table3": "^0.6.1",
    "commander": "^14.0.3",
    "type-coverage-core": "^2.30.1"
  },
  "scripts": {
    "prebuild": "node scripts/clean.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "type-coverage": "node ./dist/bin/typescript-coverage-report.js",
    "docs": "pnpm run type-coverage --outputDir docs",
    "prepare": "husky",
    "prepack": "pnpm run build",
    "check:package": "node scripts/check-package.mjs",
    "e2e": "node scripts/smoke-install.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "package-json-type": "^1.0.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "peerDependencies": {
    "typescript": "2 || 3 || 4 || 5 || 6"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "typeCoverage": {
    "atLeast": 90
  }
}
