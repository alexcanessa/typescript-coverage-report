{
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "rootDir": "src",
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "inlineSourceMap": true,
    "jsx": "react"
  },
  "exclude": [
    "**/__tests__/**",
    "dist",
    "node_modules",
    "test",
    "coverage",
    "coverage-ts",
    "docs",
    "_site"
  ],
  "include": ["src"]
}
